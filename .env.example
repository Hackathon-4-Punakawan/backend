PORT=8000

# Supabase API Settings (Project Reference: owratohibyaiibcgyoer)
SUPABASE_URL=https://owratohibyaiibcgyoer.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Connection String (Supabase Connection Pooling)
# Dapatkan password database Anda dari Supabase Dashboard -> Project Settings -> Database
DATABASE_URL=postgresql://postgres.owratohibyaiibcgyoer:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Resend API & Email Configuration (resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=UNIKA.IN <onboarding@resend.dev>

# Optional SMTP Settings (Resend SMTP Fallback)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
SMTP_FROM=UNIKA.IN <onboarding@resend.dev>
